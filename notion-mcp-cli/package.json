{
  "name": "notion-mcp-cli",
  "version": "0.0.8",
  "type": "module",
  "description": "CLI for Notion MCP with OAuth support",
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/goke",
    "directory": "notion-mcp-cli"
  },
  "homepage": "https://github.com/remorses/goke/tree/main/notion-mcp-cli",
  "bugs": "https://github.com/remorses/goke/issues",
  "keywords": [
    "notion",
    "mcp",
    "cli",
    "model-context-protocol"
  ],
  "bin": {
    "notion-mcp-cli": "bin.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./src": {
      "types": "./src/cli.ts",
      "default": "./src/cli.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "bin.js"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "author": "Tommaso De Rossi, morse <beats.by.morse@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@goke/mcp": "workspace:^",
    "goke": "workspace:^",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
